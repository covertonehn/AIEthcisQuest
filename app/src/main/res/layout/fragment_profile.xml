<?xml version="1.0" encoding="utf-8"?>
<!--
    个人中心页面布局.
    包含：用户信息卡片、错题本入口卡片、挑战历史记录卡片列表。
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background">

    <!-- 用户信息卡片 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_medium"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/card_elevation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tv_profile_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_title"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_small" />

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_subtitle"
                android:textColor="@color/color_hint_text"
                tools:text="你好，探索者！" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- 可滚动内容区 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingBottom="@dimen/spacing_large">

            <!-- 错题本入口卡片 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_wrong_book"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_large"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="📝"
                        android:textSize="24sp"
                        android:background="@drawable/bg_game_icon"
                        android:layout_marginEnd="@dimen/spacing_medium" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_wrong_book_entry_title"
                            android:textSize="@dimen/text_size_subtitle"
                            android:textStyle="bold"
                            android:layout_marginBottom="@dimen/spacing_xsmall" />

                        <TextView
                            android:id="@+id/tv_wrong_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_body"
                            android:textColor="@color/color_hint_text"
                            tools:text="共 3 道错题" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="24sp"
                        android:textColor="@color/color_hint_text"
                        android:layout_marginStart="@dimen/spacing_small" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ===== 识图挑战历史入口卡片 ===== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_challenge_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_large"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="🏆"
                        android:textSize="24sp"
                        android:background="@drawable/bg_game_icon"
                        android:layout_marginEnd="@dimen/spacing_medium" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_history_title"
                            android:textSize="@dimen/text_size_subtitle"
                            android:textStyle="bold"
                            android:layout_marginBottom="@dimen/spacing_xsmall" />

                        <TextView
                            android:id="@+id/tv_history_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_body"
                            android:textColor="@color/color_hint_text"
                            tools:text="共 5 轮挑战" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="24sp"
                        android:textColor="@color/color_hint_text"
                        android:layout_marginStart="@dimen/spacing_small" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ===== 视频挑战历史入口卡片 ===== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_video_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_large"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="🎬"
                        android:textSize="24sp"
                        android:background="@drawable/bg_game_icon"
                        android:layout_marginEnd="@dimen/spacing_medium" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_video_history_title"
                            android:textSize="@dimen/text_size_subtitle"
                            android:textStyle="bold"
                            android:layout_marginBottom="@dimen/spacing_xsmall" />

                        <TextView
                            android:id="@+id/tv_video_history_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_body"
                            android:textColor="@color/color_hint_text"
                            tools:text="共 3 轮挑战" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="24sp"
                        android:textColor="@color/color_hint_text"
                        android:layout_marginStart="@dimen/spacing_small" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>