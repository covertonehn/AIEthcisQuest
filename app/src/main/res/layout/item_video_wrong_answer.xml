<?xml version="1.0" encoding="utf-8"?>
<!--
    视频挑战错题记录列表 Item 布局.
    展示：题目编号、答题时间、双视频缩略图（带播放图标）、错误提示。
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_medium"
    android:layout_marginVertical="@dimen/spacing_small"
    app:cardCornerRadius="@dimen/wrong_item_corner_radius"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- 顶部信息行：题目编号 + 时间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_small">

            <TextView
                android:id="@+id/tv_video_index"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_category_tag"
                android:paddingHorizontal="@dimen/spacing_small"
                android:paddingVertical="2dp"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_caption"
                tools:text="第 1 题" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_caption"
                android:textColor="@color/color_hint_text"
                tools:text="06-01 12:30" />

        </LinearLayout>

        <!-- 双视频缩略图行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 上方视频（点击播放全屏） -->
            <FrameLayout
                android:layout_width="@dimen/wrong_item_image_size"
                android:layout_height="@dimen/wrong_item_image_size"
                android:layout_marginEnd="@dimen/spacing_xsmall"
                android:background="@color/black"
                android:clickable="true"
                android:focusable="true">

                <!-- 播放按钮图标（作为缩略图替代） -->
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_video_play_circle"
                    android:contentDescription="@string/label_top_image" />

                <!-- 上方视频标签（AI/真实） -->
                <TextView
                    android:id="@+id/tv_top_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:text="AI" />

                <!-- 点击整个区域的透明触摸层 -->
                <View
                    android:id="@+id/touch_top_video"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true" />

            </FrameLayout>

            <!-- VS 分隔符 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VS"
                android:textStyle="bold"
                android:textColor="@color/color_hint_text"
                android:layout_marginHorizontal="@dimen/spacing_small" />

            <!-- 下方视频（点击播放全屏） -->
            <FrameLayout
                android:layout_width="@dimen/wrong_item_image_size"
                android:layout_height="@dimen/wrong_item_image_size"
                android:layout_marginStart="@dimen/spacing_xsmall"
                android:background="@color/black"
                android:clickable="true"
                android:focusable="true">

                <!-- 播放按钮图标 -->
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_video_play_circle"
                    android:contentDescription="@string/label_bottom_image" />

                <!-- 下方视频标签（AI/真实） -->
                <TextView
                    android:id="@+id/tv_bottom_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:text="真实" />

                <!-- 点击整个区域的透明触摸层 -->
                <View
                    android:id="@+id/touch_bottom_video"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true" />

            </FrameLayout>

            <!-- 错误提示文字 -->
            <TextView
                android:id="@+id/tv_error_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_medium"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/color_wrong"
                tools:text="你选了上方视频，AI 在下方视频" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>

