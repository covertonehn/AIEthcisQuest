<?xml version="1.0" encoding="utf-8"?>
<!--
    全屏视频播放页布局.
    黑色背景，TextureView 居中展示。
    单击视频区域：切换控制栏显隐。双击：播放/暂停。
    顶部栏（返回）和底部栏（播放/暂停 + 进度条 + 退出全屏）均可隐藏，实现沉浸式播放。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 视频渲染区域（gravity=center 实现居中） -->
    <TextureView
        android:id="@+id/texture_view_fullscreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <!-- 中央播放图标（未播放时） -->
    <ImageView
        android:id="@+id/overlay_play_fullscreen"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_video_play_circle"
        android:visibility="gone"
        android:contentDescription="@string/video_play_hint" />

    <!-- 加载进度条（Spinner） -->
    <ProgressBar
        android:id="@+id/progress_bar_fullscreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 顶部操作栏（返回按钮），默认隐藏，单击视频出现 -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="#AA000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_back_fullscreen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back_home"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/white" />

        <TextView
            android:id="@+id/tv_fullscreen_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/video_fullscreen_title"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            android:paddingStart="8dp" />

    </LinearLayout>

    <!-- 底部控制栏（播放/暂停 + 进度条 + 退出全屏），默认隐藏 -->
    <LinearLayout
        android:id="@+id/layout_bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="#AA000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <!-- 播放/暂停 -->
        <ImageButton
            android:id="@+id/btn_play_pause_fullscreen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/video_play_pause_hint"
            android:src="@drawable/ic_video_play"
            android:tint="@color/white" />

        <!-- 播放进度条 -->
        <SeekBar
            android:id="@+id/seek_bar_fullscreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:thumbTint="@color/white"
            android:progressTint="@color/white"
            android:progressBackgroundTint="#66FFFFFF" />

        <!-- 退出全屏 -->
        <ImageButton
            android:id="@+id/btn_exit_fullscreen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/video_exit_fullscreen_hint"
            android:src="@drawable/ic_video_fullscreen_exit"
            android:tint="@color/white" />

    </LinearLayout>

</FrameLayout>

