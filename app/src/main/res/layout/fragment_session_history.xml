<?xml version="1.0" encoding="utf-8"?>
<!--
    挑战历史列表页布局.
    展示所有历史挑战轮次，每轮显示时间、得分、正确率和缩略图，
    可点击进入该轮详情。
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background">

    <!-- 顶部统计信息栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingVertical="@dimen/spacing_small">

        <TextView
            android:id="@+id/tv_total_sessions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/color_hint_text"
            tools:text="共 5 轮挑战" />

    </LinearLayout>

    <!-- 空状态 -->
    <LinearLayout
        android:id="@+id/layout_history_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        tools:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_history_empty"
            android:textSize="@dimen/text_size_subtitle"
            android:textColor="@color/color_hint_text"
            android:gravity="center" />

    </LinearLayout>

    <!-- 历史记录列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_session_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="@dimen/spacing_small"
        tools:listitem="@layout/item_session_record" />

</LinearLayout>

