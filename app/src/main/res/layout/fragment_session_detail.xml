<?xml version="1.0" encoding="utf-8"?>
<!--
    挑战历史详情页布局.
    展示某一轮挑战的汇总信息（时间、得分、正确率）和每道题的双图详情。
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background">

    <!-- 顶部汇总卡片 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_medium"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/card_elevation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_large"
            android:gravity="center_vertical">

            <!-- 左侧：时间和得分 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_detail_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_caption"
                    android:textColor="@color/color_hint_text"
                    android:layout_marginBottom="@dimen/spacing_xsmall"
                    tools:text="2026-06-01 14:30" />

                <TextView
                    android:id="@+id/tv_detail_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold"
                    tools:text="答对 8 / 10 题" />

            </LinearLayout>

            <!-- 右侧：正确率圆形徽章 -->
            <TextView
                android:id="@+id/tv_detail_accuracy"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:gravity="center"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_accuracy_badge"
                tools:text="80%" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- 每题详情列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_session_detail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="@dimen/spacing_small"
        tools:listitem="@layout/item_session_detail_question" />

</LinearLayout>

